{
  "name": "benten",
  "version": "0.1.0",
  "description": "Benten - desktop music player",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:cdp": "node scripts/cdp-smoke.mjs",
    "postinstall": "install-electron",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-vite build && electron-builder --win",
    "pack:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "better-sqlite3": "13.0.3",
    "chokidar": "3.6.0",
    "framer-motion": "11.18.2",
    "lucide-react": "0.468.0",
    "music-metadata": "12.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "24.13.3",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
